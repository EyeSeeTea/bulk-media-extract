msgid "Add new"
msgstr "Añadir"

msgid "Manage"
msgstr "Gestionar"

msgid "Back"
msgstr "Volver"

msgid "Help"
msgstr "Ayuda"

msgid "Close"
msgstr "Cerrar"

msgid "Step {{number}}"
msgstr "Paso {{number}}"

msgid "Validation required"
msgstr "Validación requerida"

msgid "Next"
msgstr "Siguiente"

