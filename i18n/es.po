msgstr "Error desconocido"

msgid "Bulk Media Extract"
msgstr "Extracción masiva de archivos"

msgid ""
"Export file data values from your programs to WebDAV or a local directory."
msgstr ""
"Exportar valores de datos de archivo de sus programas a WebDAV o a un "
"directorio local."

msgid "Start new export"
msgstr "Iniciar nueva exportación"

msgid "Event preview"
msgstr "Vista previa de eventos"

msgid "Select organisation unit"
msgstr "Seleccionar unidad organizativa"

msgid "Program required"
msgstr "Programa requerido"

msgid "Select a program to load organisation units."
msgstr "Seleccione un programa para cargar las unidades organizativas."

msgid "No organisation units available"
msgstr "No hay unidades organizativas disponibles"

msgid "The selected program has no organisation units available for selection."
msgstr ""
"El programa seleccionado no tiene unidades organizativas disponibles para "
"seleccionar."

msgid "Preview requirements"
msgstr "Requisitos de vista previa"

msgid "Select both a program and an organisation unit to preview events."
msgstr ""
"Seleccione un programa y una unidad organizativa para previsualizar eventos."

msgid "Could not load event preview"
msgstr "No se pudo cargar la vista previa de eventos"

msgid "Retry preview"
msgstr "Reintentar vista previa"

msgid "Matching events: {{total}}. Pages: {{pages}}."
msgstr "Eventos coincidentes: {{total}}. Páginas: {{pages}}."

msgid "No events found"
msgstr "No se encontraron eventos"

msgid "No preview events match the current selections."
msgstr "Ningún evento coincide con las selecciones actuales."

msgid "Event"
msgstr "Evento"

msgid "Date"
msgstr "Fecha"

msgid "Org unit"
msgstr "Unidad organizativa"

msgid "File values"
msgstr "Valores de archivo"

msgid "Selected program details"
msgstr "Detalles del programa seleccionado"

msgid "No program selected"
msgstr "Ningún programa seleccionado"

msgid "Select a program to inspect its file properties."
msgstr "Seleccione un programa para inspeccionar sus propiedades de archivo."

msgid "Could not inspect program"
msgstr "No se pudo inspeccionar el programa"

msgid "Program type"
msgstr "Tipo de programa"

msgid "No file properties found"
msgstr "No se encontraron propiedades de archivo"

msgid "This program has no resolvable file-capable properties."
msgstr ""
"Este programa no tiene propiedades de archivo resolubles."

msgid "Program"
msgstr "Programa"

msgid "Could not load programs"
msgstr "No se pudieron cargar los programas"

msgid "Select a file-capable program"
msgstr "Seleccione un programa con archivos"

msgid "Choose a program"
msgstr "Elegir un programa"

msgid "Reload programs"
msgstr "Recargar programas"

msgid "Export program files"
msgstr "Exportar archivos del programa"

msgid "Exit current export"
msgstr "Salir de la exportación actual"

msgid ""
"All configuration entered in this export session will be lost. This action "
"cannot be undone."
msgstr ""
"Toda la configuración introducida en esta sesión de exportación se perderá. "
"Esta acción no se puede deshacer."

msgid "Continue editing"
msgstr "Continuar editando"

msgid "Exit export"
msgstr "Salir de la exportación"

msgid "Success"
msgstr "Éxito"

msgid "Failure"
msgstr "Error"

msgid "Warning"
msgstr "Advertencia"

msgid "Info"
msgstr "Información"

msgid "Event {{eventId}} — {{dataElement}}"
msgstr "Evento {{eventId}} — {{dataElement}}"

msgid "Run the export"
msgstr "Ejecutar la exportación"

msgid "Transfer the reviewed files to the configured destination."
msgstr "Transferir los archivos revisados al destino configurado."

msgid "Processed"
msgstr "Procesados"

msgid "Progress"
msgstr "Progreso"

msgid "Successes"
msgstr "Exitosos"

msgid "Failures"
msgstr "Fallidos"

msgid "Retry export"
msgstr "Reintentar exportación"

msgid "Start export"
msgstr "Iniciar exportación"

msgid "Interrupt export"
msgstr "Interrumpir exportación"

msgid "Download result summary"
msgstr "Descargar resumen de resultados"

msgid "Export in progress"
msgstr "Exportación en curso"

msgid "Latest execution progress"
msgstr "Último progreso de ejecución"

msgid "Processed {{processed}} of {{total}} files ({{progress}}%)."
msgstr "Procesados {{processed}} de {{total}} archivos ({{progress}}%)."

msgid "Execution progress"
msgstr "Progreso de ejecución"

msgid "Latest target path: {{path}}"
msgstr "Última ruta de destino: {{path}}"

msgid "Execution log"
msgstr "Registro de ejecución"

msgid "Export completed"
msgstr "Exportación completada"

msgid "All files processed successfully."
msgstr "Todos los archivos se procesaron correctamente."

msgid "Export completed with failures"
msgstr "Exportación completada con errores"

msgid "Export failed"
msgstr "Exportación fallida"

msgid "Export interrupted"
msgstr "Exportación interrumpida"

msgid "Review the resolved export plan"
msgstr "Revisar el plan de exportación resuelto"

msgid ""
"Inspect the final target paths and warnings before you unlock the storage "
"and execution steps."
msgstr ""
"Inspeccione las rutas de destino finales y las advertencias antes de "
"desbloquear los pasos de almacenamiento y ejecución."

msgid "Select program and organisation unit filter before loading preview."
msgstr ""
"Seleccione un programa y un filtro de unidad organizativa antes de cargar la "
"vista previa."

msgid "Selected file data elements"
msgstr "Elementos de datos de archivo seleccionados"

msgid "Org unit mode"
msgstr "Modo de unidad organizativa"

msgid "Selected"
msgstr "Seleccionados"

msgid "Descendants"
msgstr "Descendientes"

msgid "Preview the resolved export rows before continuing."
msgstr "Previsualice las filas de exportación resueltas antes de continuar."

msgid "No files found"
msgstr "No se encontraron archivos"

msgid "No exportable files match the selected date filters."
msgstr ""
"Ningún archivo exportable coincide con los filtros de fecha seleccionados."

msgid "No exportable files match the current selection."
msgstr "Ningún archivo exportable coincide con la selección actual."

msgid "File data value"
msgstr "Valor de dato de archivo"

msgid "Source filename"
msgstr "Nombre del archivo de origen"

msgid "Size"
msgstr "Tamaño"

msgid "Target"
msgstr "Destino"

msgid "Original file"
msgstr "Archivo original"

msgid "Duplicate target filepaths detected"
msgstr "Rutas de destino duplicadas detectadas"

msgid "Files will be skipped"
msgstr "Los archivos se omitirán"

msgid "Files"
msgstr "Archivos"

msgid "Total size"
msgstr "Tamaño total"

msgid "Export configuration"
msgstr "Configuración de exportación"

msgid ""
"Download a JSON execution configuration for the current reviewed preview."
msgstr ""
"Descargar una configuración de ejecución JSON para la vista previa revisada "
"actual."

msgid "Execution configuration downloaded"
msgstr "Configuración de ejecución descargada"

msgid "The JSON execution configuration for this preview was downloaded."
msgstr ""
"La configuración de ejecución JSON para esta vista previa ha sido descargada."

msgid "Choose a program and the files to export"
msgstr "Elija un programa y los archivos a exportar"

msgid ""
"Start by selecting the tracker program. Then confirm which file data values "
"should move forward to template setup and preview."
msgstr ""
"Comience seleccionando el programa tracker. Luego confirme qué valores de "
"datos de archivo deben avanzar a la configuración de plantilla y vista previa."

msgid "Only programs with file-capable data values are listed."
msgstr "Solo se muestran programas con valores de datos de archivo."

msgid "Search programs"
msgstr "Buscar programas"

msgid "No matching programs"
msgstr "No hay programas coincidentes"

msgid "File data values to sync"
msgstr "Valores de datos de archivo a sincronizar"

msgid "Choose the file fields to include in the export flow."
msgstr "Elija los campos de archivo a incluir en el flujo de exportación."

msgid "Select a program to inspect file data values."
msgstr "Seleccione un programa para inspeccionar los valores de datos de archivo."

msgid "Loading file-capable data values"
msgstr "Cargando valores de datos con capacidad de archivo"

msgid "No file data elements"
msgstr "Sin elementos de datos de archivo"

msgid "No file-capable data elements were found in this program."
msgstr ""
"No se encontraron elementos de datos con capacidad de archivo en este programa."

msgid "No program stage"
msgstr "Sin etapa de programa"

msgid "Program summary"
msgstr "Resumen del programa"

msgid "File fields found"
msgstr "Campos de archivo encontrados"

msgid "Program stages"
msgstr "Etapas del programa"

msgid "Program details will appear here once the selection is loaded."
msgstr ""
"Los detalles del programa aparecerán aquí una vez cargada la selección."

msgid "Why this matters"
msgstr "Por qué es importante"

msgid ""
"The files selected here determine which mapping editors and preview rows "
"appear in later steps."
msgstr ""
"Los archivos seleccionados aquí determinan qué editores de mapeo y filas de "
"vista previa aparecen en los pasos posteriores."

msgid "Testing connection..."
msgstr "Probando conexión..."

msgid "Retest connection"
msgstr "Reprobar conexión"

msgid "Test connection"
msgstr "Probar conexión"

msgid "Validating directory..."
msgstr "Validando directorio..."

msgid "Revalidate directory"
msgstr "Revalidar directorio"

msgid "Validate directory"
msgstr "Validar directorio"

msgid "Choose the export destination"
msgstr "Elija el destino de exportación"

msgid ""
"Select how the reviewed files should be written, then complete the setup for "
"that destination."
msgstr ""
"Seleccione cómo deben escribirse los archivos revisados y complete la "
"configuración de ese destino."

msgid "Storage method"
msgstr "Método de almacenamiento"

msgid ""
"You can switch between methods before execution. Only the selected method "
"must be validated."
msgstr ""
"Puede cambiar entre métodos antes de la ejecución. Solo el método "
"seleccionado debe ser validado."

msgid "WebDAV"
msgstr "WebDAV"

msgid "Connect to a remote WebDAV-compatible server."
msgstr "Conectar a un servidor remoto compatible con WebDAV."

msgid "Local directory"
msgstr "Directorio local"

msgid "Write files directly into a folder on this computer."
msgstr "Escribir archivos directamente en una carpeta de este equipo."

msgid "Connection details"
msgstr "Detalles de conexión"

msgid ""
"Enter the WebDAV endpoint URL and credentials that the browser will use "
"during export."
msgstr ""
"Introduzca la URL del endpoint WebDAV y las credenciales que el navegador "
"usará durante la exportación."

msgid "WebDAV URL"
msgstr "URL de WebDAV"

msgid "Username"
msgstr "Nombre de usuario"

msgid "Password"
msgstr "Contraseña"

msgid "You must pass this test before continuing to execution."
msgstr "Debe superar esta prueba antes de continuar con la ejecución."

msgid "Storage setup"
msgstr "Configuración de almacenamiento"

msgid ""
"Use a WebDAV-compatible storage service such as ownCloud, Nextcloud, or "
"another WebDAV-enabled server."
msgstr ""
"Utilice un servicio de almacenamiento compatible con WebDAV como ownCloud, "
"Nextcloud u otro servidor habilitado para WebDAV."

msgid ""
"Use the direct WebDAV endpoint, not a generic product homepage or login page."
msgstr ""
"Utilice el endpoint WebDAV directo, no una página de inicio genérica o de "
"inicio de sesión."

msgid ""
"The WebDAV server must allow cross-origin requests from this app origin "
"(CORS) or the browser will block validation and file transfer."
msgstr ""
"El servidor WebDAV debe permitir solicitudes de origen cruzado desde el "
"origen de esta aplicación (CORS) o el navegador bloqueará la validación y la "
"transferencia de archivos."

msgid ""
"If your server sits behind a proxy or self-signed TLS setup, make sure the "
"browser can reach it successfully from this environment."
msgstr ""
"Si su servidor está detrás de un proxy o una configuración TLS autofirmada, "
"asegúrese de que el navegador pueda acceder correctamente desde este entorno."

msgid "Destination directory"
msgstr "Directorio de destino"

msgid ""
"Choose the local folder where the reviewed export paths will be created "
"during this browser session."
msgstr ""
"Elija la carpeta local donde se crearán las rutas de exportación revisadas "
"durante esta sesión del navegador."

msgid "Choose a different folder"
msgstr "Elegir otra carpeta"

msgid "Choose folder"
msgstr "Elegir carpeta"

msgid "Selected folder: {{name}}"
msgstr "Carpeta seleccionada: {{name}}"

msgid "No local folder selected yet."
msgstr "Aún no se ha seleccionado una carpeta local."

msgid "Validate the selected folder before continuing to execution."
msgstr "Valide la carpeta seleccionada antes de continuar con la ejecución."

msgid "Local directory setup"
msgstr "Configuración de directorio local"

msgid ""
"Local directory export writes files directly into a folder on this computer "
"instead of sending them to a remote server."
msgstr ""
"La exportación a directorio local escribe archivos directamente en una "
"carpeta de este equipo en lugar de enviarlos a un servidor remoto."

msgid ""
"This option requires browser support for the File System Access API, which "
"is typically available in Chromium-based browsers."
msgstr ""
"Esta opción requiere compatibilidad del navegador con la API File System "
"Access, disponible normalmente en navegadores basados en Chromium."

msgid ""
"Folder access applies only to the current browser session. If you reload the "
"app, choose the folder again."
msgstr ""
"El acceso a la carpeta aplica solo a la sesión actual del navegador. Si "
"recarga la aplicación, elija la carpeta de nuevo."

msgid ""
"The export will recreate the reviewed folder structure under the selected "
"local directory."
msgstr ""
"La exportación recreará la estructura de carpetas revisada dentro del "
"directorio local seleccionado."

msgid "Testing connection"
msgstr "Probando conexión"

msgid ""
"Checking whether this browser can reach the WebDAV endpoint with the "
"provided credentials."
msgstr ""
"Comprobando si este navegador puede alcanzar el endpoint WebDAV con las "
"credenciales proporcionadas."

msgid "Connection valid"
msgstr "Conexión válida"

msgid "WebDAV connection validated. You can continue to execution."
msgstr "Conexión WebDAV validada. Puede continuar con la ejecución."

msgid "Connection invalid"
msgstr "Conexión no válida"

msgid "Review the setup remarks above and try again."
msgstr "Revise las observaciones de configuración anteriores e inténtelo de nuevo."

msgid "Validating directory"
msgstr "Validando directorio"

msgid ""
"Checking whether this browser session can write files into the selected "
"local directory."
msgstr ""
"Comprobando si esta sesión del navegador puede escribir archivos en el "
"directorio local seleccionado."

msgid "Directory valid"
msgstr "Directorio válido"

msgid "Local directory validated. You can continue to execution."
msgstr "Directorio local validado. Puede continuar con la ejecución."

msgid "Directory invalid"
msgstr "Directorio no válido"

msgid "Choose a supported browser or select a different folder and try again."
msgstr ""
"Elija un navegador compatible o seleccione una carpeta diferente e "
"inténtelo de nuevo."

msgid "Define the export scope and filename templates"
msgstr "Definir el alcance de exportación y las plantillas de nombre de archivo"

msgid ""
"Choose where to look for records, then define the destination path for each "
"selected file field."
msgstr ""
"Elija dónde buscar registros y defina la ruta de destino para cada campo de "
"archivo seleccionado."

msgid "Filters"
msgstr "Filtros"

msgid "Organisation unit"
msgstr "Unidad organizativa"

msgid "Select a program first to filter by organisation unit."
msgstr "Seleccione un programa primero para filtrar por unidad organizativa."

msgid "Include"
msgstr "Incluir"

msgid "Date from (optional)"
msgstr "Fecha desde (opcional)"

msgid "Date to (optional)"
msgstr "Fecha hasta (opcional)"

msgid "No selected files"
msgstr "Sin archivos seleccionados"

msgid "Go back to step 1 and select at least one file data value to sync."
msgstr ""
"Vuelva al paso 1 y seleccione al menos un valor de dato de archivo a "
"sincronizar."

msgid "Path and filename template - {{name}}"
msgstr "Plantilla de ruta y nombre de archivo - {{name}}"

msgid ""
"Use tokens like {orgUnitName}, {enrollmentDate}, {attribute:NationalID}, "
"{dataElement:FileName}."
msgstr ""
"Use tokens como {orgUnitName}, {enrollmentDate}, {attribute:NationalID}, "
"{dataElement:FileName}."

msgid "Required."
msgstr "Obligatorio."

msgid "Valid template. Preview:"
msgstr "Plantilla válida. Vista previa:"

msgid "Select program and organisation unit to load resolved values."
msgstr ""
"Seleccione un programa y una unidad organizativa para cargar los valores "
"resueltos."

msgid "Could not load resolved values."
msgstr "No se pudieron cargar los valores resueltos."

msgid "No resolved template values found for current filters."
msgstr ""
"No se encontraron valores de plantilla resueltos para los filtros actuales."

msgid "Available properties"
msgstr "Propiedades disponibles"

msgid "Select a program to inspect available properties."
msgstr "Seleccione un programa para inspeccionar las propiedades disponibles."

msgid "Could not inspect program properties"
msgstr "No se pudieron inspeccionar las propiedades del programa"

msgid "No properties found"
msgstr "No se encontraron propiedades"

msgid "No resolvable properties were found for this program."
msgstr "No se encontraron propiedades resolubles para este programa."

